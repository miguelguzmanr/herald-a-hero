{
    "name": "herald-a-hero",
    "version": "0.0.0",
    "private": true,
    "description": "An unofficial hero builder for Herald's Decree.",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
